<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="24dp"
    tools:context=".ui.HomeFragment">

    <!-- Header Container -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivSchoolLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="-8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo SMKN 1 Bojong"
            android:scaleType="fitCenter"
            android:src="@drawable/nebo_exam" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:text="NeboExam"
            android:textColor="#0D2B45"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSchoolSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="SMKN 1 BOJONG PURWAKARTA"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Kartu Peraturan Ujian -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRules"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Petunjuk &amp; Peraturan Ujian"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="1. Dilarang meninggalkan aplikasi saat ujian berlangsung.\n2. Dilarang menggunakan fitur Split Screen atau Multi-Window.\n3. Dilarang mengambil tangkapan layar (Screenshot) atau merekam layar.\n4. Pelanggaran aturan di atas akan mengakibatkan perangkat TERKUNCI OTOMATIS SELAMA 1 JAM."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Mulai Scan Ujian -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartExam"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="32dp"
        android:text="MULAI SCAN UJIAN"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#0D2B45"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
